# MongoDB Atlas
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
DATABASE_NAME=coursemate_ai

# JWT (generate JWT_SECRET_KEY with the command in the setup notes; never commit the real value)
JWT_SECRET_KEY=replace-with-a-generated-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30